# ---- Outreach OAuth ----
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=
OUTREACH_REFRESH_TOKEN=
OUTREACH_REDIRECT_URI=http://localhost:8080/callback

# ---- Gmail OAuth ----
# Path to the OAuth client JSON downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=credentials.json
# Path where the generated user token is persisted.
GMAIL_TOKEN_PATH=token.json

# ---- Identity ----
MANET_EMAIL=manet@example.com

# ---- Behavior ----
POLL_INTERVAL_MIN=5
OPEN_THRESHOLD=2
THREAD_LOOKBACK_DAYS=30

# ---- Storage ----
DB_PATH=nudges.db

# ---- Recap cron (day-of-week: mon,tue,wed,thu,fri,sat,sun) ----
RECAP_CRON_DAY=fri
RECAP_CRON_HOUR=8
RECAP_CRON_MINUTE=0
TIMEZONE=America/Chicago

# ---- Account News Digest ----
# Gmail address that sends the digest (must be the OAuth'd Gmail user).
GMAIL_SENDER=you@example.com
# Optional: CC address (e.g. yourself) on every per-AE digest.
DIGEST_CC=

# Folder containing one CSV per AE: accounts/<ae_email>.csv
ACCOUNTS_DIR=accounts

# Optional: Google Custom Search API. Without these, only Google News RSS is used.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Lookback window for news items (hours)
NEWS_LOOKBACK_HOURS=24
