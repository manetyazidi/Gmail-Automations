# ---- Outreach OAuth ----
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=
OUTREACH_REFRESH_TOKEN=
OUTREACH_REDIRECT_URI=http://localhost:8080/callback

# ---- Gmail OAuth ----
# Path to the OAuth client JSON downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=credentials.json
# Path where the generated user token is persisted.
GMAIL_TOKEN_PATH=token.json

# ---- Identity ----
MANET_EMAIL=manet@example.com

# ---- Behavior ----
POLL_INTERVAL_MIN=5
OPEN_THRESHOLD=2
THREAD_LOOKBACK_DAYS=30

# ---- Storage ----
DB_PATH=nudges.db

# ---- Recap cron (day-of-week: mon,tue,wed,thu,fri,sat,sun) ----
RECAP_CRON_DAY=fri
RECAP_CRON_HOUR=8
RECAP_CRON_MINUTE=0
TIMEZONE=America/Chicago

# ---- Account News Digest ----
# AE whose accounts will be scanned (matched against Account.Owner.Email in SF).
AE_EMAIL=ae@example.com
# Optional: where the 7am digest is sent. Defaults to AE_EMAIL.
DIGEST_TO=ae@example.com
# Gmail address that sends the digest (must be the OAuth'd user).
GMAIL_SENDER=ae@example.com

# Salesforce connected-app OAuth (refresh-token flow)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
SF_LOGIN_URL=https://login.salesforce.com

# Optional: Google Custom Search API. Without these, only Google News RSS is used.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Lookback window for news items (hours)
NEWS_LOOKBACK_HOURS=24
